{
  "$comment": "This repository holds code only: no evidence, no knowledge, nothing private. The sandbox is still on and fails closed, matching the federation posture (VIS-S5), and .env is refused on principle even though none exists.",
  "permissions": {
    "deny": ["Read(.env)", "Read(.env.*)"]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": [],
      "allowWrite": ["~/Library/pnpm/store", "~/Library/Caches/pnpm"]
    },
    "credentials": {
      "files": [
        { "path": "./.env", "mode": "deny" },
        { "path": "./.env.*", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org", "npm.jsr.io"]
    }
  }
}
